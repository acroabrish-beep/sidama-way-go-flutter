rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for baseline city data
    match /announcements/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /hospitals/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /pharmacies/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /medicines/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /tourism_sites/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /hotels/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /restaurants/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /menu_items/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /terminal_routes/{doc} { allow read: if true; allow write: if request.auth != null; }

    // Authenticated user transactions
    match /bookings/{doc} { allow read, write: if request.auth != null; }
    match /taxi_requests/{doc} { allow read, write: if request.auth != null; }
    match /taxi_payments/{doc} { allow read, write: if request.auth != null; }
    match /hotel_reservations/{doc} { allow read, write: if request.auth != null; }
    match /appointments/{doc} { allow read, write: if request.auth != null; }
    match /medicine_orders/{doc} { allow read, write: if request.auth != null; }
    match /food_orders/{doc} { allow read, write: if request.auth != null; }
    match /sos_requests/{doc} { allow read, write: if request.auth != null; }

    match /user_notifications/{doc} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Admin & System Collections
    match /drivers/{doc} { allow read, write: if request.auth != null; }
    match /audit_logs/{doc} { allow read: if request.auth != null; allow create: if request.auth != null; }
  }
}