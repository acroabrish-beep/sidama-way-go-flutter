rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
          'super_admin','old_terminal_admin','new_terminal_admin','taxi_admin',
          'tourism_admin','hotel_admin','health_admin','pharmacy_admin',
          'emergency_admin','church_admin'
        ];
    }
    function isOwner(data) {
      return signedIn() && (
        (data.userId != null && data.userId == request.auth.uid) ||
        (data.uid != null && data.uid == request.auth.uid)
      );
    }

    match /announcements/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /hospitals/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /pharmacies/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /medicines/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /tourism_sites/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /hotels/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /restaurants/{doc} { allow read: true; allow write: if isAdmin(); }
    match /menu_items/{doc} { allow read: true; allow write: if isAdmin(); }
    match /terminal_routes/{doc} { allow read: true; allow write: if isAdmin(); }

    match /bookings/{doc} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data);
      allow create: if isAdmin() || (signedIn() && isOwner(request.resource.data));
    }
    match /taxi_requests/{doc} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data);
      allow create: if isAdmin() || (signedIn() && isOwner(request.resource.data));
    }
    match /taxi_payments/{doc} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data);
      allow create: if isAdmin() || (signedIn() && isOwner(request.resource.data));
    }
    match /hotel_reservations/{doc} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data);
      allow create: if isAdmin() || (signedIn() && isOwner(request.resource.data));
    }
    match /appointments/{doc} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data);
      allow create: if isAdmin() || (signedIn() && isOwner(request.resource.data));
    }
    match /medicine_orders/{doc} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data);
      allow create: if isAdmin() || (signedIn() && isOwner(request.resource.data));
    }
    match /food_orders/{doc} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data);
      allow create: if isAdmin() || (signedIn() && isOwner(request.resource.data));
    }
    match /sos_requests/{doc} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data);
      allow create: if isAdmin() || (signedIn() && isOwner(request.resource.data));
    }

    match /user_notifications/{doc} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'citizen'
        && request.resource.data.isActive == true
        && request.resource.data.walletBalance == 0;

      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.walletBalance == resource.data.walletBalance
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.membershipNumber == resource.data.membershipNumber
        && request.resource.data.createdAt == resource.data.createdAt
      );

      allow delete: if isAdmin();
    }

    match /drivers/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /audit_logs/{doc} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}