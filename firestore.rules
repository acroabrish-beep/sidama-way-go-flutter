rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read/write their own profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Public data
    match /announcements/{docId} { allow read: if true; allow write: if hasRole('city_admin'); }
    match /tourism_places/{docId} { allow read: if true; allow write: if hasRole('city_admin'); }
    match /routes/{docId} { allow read: if true; allow write: if hasRole('city_admin') || hasRole('terminal_admin'); }

    // Protected Mobility Data
    match /tickets/{ticketId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || hasRole('terminal_admin'));
      allow create: if request.auth != null;
      allow update: if hasRole('terminal_admin');
    }

    match /queues/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /emergency_requests/{docId} {
      allow read: if hasRole('city_admin') || hasRole('emergency_responder');
      allow create: if request.auth != null;
    }

    // Helper functions
    function hasRole(role) {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
  }
}
